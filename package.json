{
  "name": "@slavshik/log",
  "version": "0.0.22",
  "description": "Tiny log with styling for the browser console.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/dts/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/dts/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/dts/strip/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js",
      "default": "./dist/vite.mjs"
    },
    "./webpack": {
      "types": "./dist/dts/strip/webpack.d.ts",
      "require": "./dist/webpack.js",
      "default": "./dist/webpack.js"
    },
    "./loader": {
      "require": "./dist/loader.js",
      "default": "./dist/loader.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": "git@github.com:slavshik/log.git",
  "author": "Alexander Slavschik",
  "license": "MIT",
  "scripts": {
    "release": "standard-version",
    "test": "vitest run",
    "build": "rimraf dist && tsc --project tsconfig.dts.json && rollup --config rollup.config.ts --configPlugin typescript"
  },
  "standard-version": {
    "releaseCommitMessageFormat": "chore(release): {{currentTag}} [ci skip]"
  },
  "dependencies": {
    "acorn": "^8.11.0"
  },
  "peerDependencies": {
    "vite": ">=3",
    "webpack": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^8.2.5",
    "rimraf": "^3.0.2",
    "rollup": "^2.56.1",
    "rollup-plugin-terser": "^7.0.2",
    "standard-version": "^9.3.2",
    "tslib": "^2.3.0",
    "typescript": "^4.3.5",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
